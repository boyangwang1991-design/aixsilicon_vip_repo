targets:
  default:
    filesets: [rtl]
    description: 供其他 Core 依赖的默认包
  lint:
    filesets: [rtl]
    description: 静态检查入口
  smoke:
    filesets: [rtl, selftest]
    toplevel: [axi4_smoke_tb]
    description: 最小闭环
  regression:
    filesets: [rtl, selftest]
    toplevel: [axi4_smoke_tb]
    description: 标准回归入口

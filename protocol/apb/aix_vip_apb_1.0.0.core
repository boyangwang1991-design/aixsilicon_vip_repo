CAPI=2:
# AIXSILICON APB VIP — FuseSoC Core
# VLNV: aix:vip:apb:1.0.0
name: aix:vip:apb:1.0.0

description: >-
  AIXSILICON APB UVM VIP：Master/Slave/Passive、wait、error、RAL adapter、
  Protocol Checker 与 Functional Coverage。

filesets:
  rtl:
    depend:
      - aix:vip:common:^1.0
    files:
      - src/apb_if.sv
      - src/apb_pkg.sv
      - src/apb_item.sv
      - src/apb_config.sv
      - src/apb_sequencer.sv
      - src/apb_master_driver.sv
      - src/apb_slave_driver.sv
      - src/apb_monitor.sv
      - src/apb_agent.sv
      - src/apb_coverage.sv
      - src/apb_checker.sv
      - src/apb_ral_adapter.sv
    file_type: systemVerilogSource
  sva:
    files:
      - sva/apb_checker_assert.sv : { file_type: systemVerilogSource }
    file_type: systemVerilogSource
  seq:
    files:
      - seq/apb_base_seq.sv
      - seq/apb_stress_seq.sv
      - seq/apb_error_seq.sv
    file_type: systemVerilogSource
  test:
    files:
      - tb/apb_smoke_tb.sv : { file_type: systemVerilogSource }
      - tb/apb_smoke_test.sv : { file_type: systemVerilogSource }
      - tb/apb_smoke_env.sv : { file_type: systemVerilogSource }
    file_type: systemVerilogSource
  example:
    files:
      - examples/apb_example_top.sv : { file_type: systemVerilogSource }
    file_type: systemVerilogSource

parameters:
  UVM_HOME:
    datatype: str
    paramtype: vlogparam
    description: UVM 源路径

targets:
  default:
    filesets: [rtl]
    description: 供其他 Core 依赖的默认包
  lint:
    filesets: [rtl]
    description: 静态检查入口
  unit_sim:
    filesets: [rtl, seq]
    description: 单元测试入口（骨架）
  smoke:
    filesets: [rtl, seq, test]
    toplevel: [apb_smoke_tb]
    description: 最小 Master—Slave 闭环
  regression:
    filesets: [rtl, seq, test]
    toplevel: [apb_smoke_tb]
    description: 标准回归入口
  negative:
    filesets: [rtl, seq, test]
    toplevel: [apb_smoke_tb]
    description: 协议异常 / 错误响应测试
  example:
    filesets: [rtl, seq, example]
    description: 最小集成示例
  formal:
    filesets: [rtl, sva]
    description: 协议属性形式验证（可选）
  package:
    filesets: [rtl, seq]
    description: 生成正式发布包
